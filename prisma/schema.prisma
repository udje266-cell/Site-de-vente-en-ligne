generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  position  Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@index([parentId])
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  description  String           @default("")
  categoryId   String?
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  variants     ProductVariant[]
  isActive     Boolean          @default(true)
  isFeatured   Boolean          @default(false)
  // Délai de livraison indicatif propre au produit (sinon celui de la zone)
  leadTimeNote String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  width     Int     @default(800)
  height    Int     @default(800)
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String      @unique
  label          String
  attributes     Json        @default("{}")
  price          Int
  compareAtPrice Int?
  stock          Int         @default(0)
  isActive       Boolean     @default(true)
  position       Int         @default(0)
  orderItems     OrderItem[]

  @@index([productId])
}

enum PaymentMethod {
  CINETPAY
  COD
}

enum PaymentStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COD_PENDING
  CONFIRMED
  PREPARED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  number          String        @unique
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryZoneId  String?
  deliveryZone    DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryAddress String        @default("")
  deliveryNote    String?
  pickup          Boolean       @default(false)
  subtotal        Int
  discount        Int           @default(0)
  shippingFee     Int           @default(0)
  total           Int
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  status          OrderStatus
  // true tant que le stock de la commande est retenu (décrémenté ou réservé)
  stockHeld       Boolean       @default(true)
  promoCodeId     String?
  promoCode       PromoCode?    @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  // P2 : customerId? pour les comptes clients
  items           OrderItem[]
  events          OrderEvent[]
  payments        Payment[]
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  // Liste admin filtrée par statut + tri par date, et expiration des paiements
  @@index([status, createdAt])
  @@index([customerPhone])
  @@index([createdAt])
  @@index([deliveryZoneId])
  @@index([promoCodeId])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName  String
  variantLabel String
  unitPrice    Int
  quantity     Int

  @@index([orderId])
  @@index([variantId])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  message    String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String
  transactionId String        @unique
  amount        Int
  status        PaymentStatus @default(PENDING)
  paymentUrl    String?
  rawPayload    Json          @default("[]")
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@index([orderId])
}

model DeliveryZone {
  id       String  @id @default(cuid())
  name     String  @unique
  fee      Int
  etaLabel String
  isActive Boolean @default(true)
  position Int     @default(0)
  orders   Order[]
}

enum PromoType {
  PERCENT
  FIXED
}

model PromoCode {
  id          String    @id @default(cuid())
  // Stocké en MAJUSCULES pour une comparaison insensible à la casse
  code        String    @unique
  type        PromoType
  value       Int
  minSubtotal Int?
  maxUses     Int?
  usedCount   Int       @default(0)
  startsAt    DateTime? @db.Timestamptz(3)
  endsAt      DateTime? @db.Timestamptz(3)
  isActive    Boolean   @default(true)
  orders      Order[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String   @default("")
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Setting {
  key   String @id
  value String
}

enum AdminRole {
  OWNER
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(OWNER)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
}

// Compteur pour les numéros de commande séquentiels (une ligne par année)
model OrderSequence {
  year  Int @id
  value Int @default(0)
}

// Limitation des tentatives (connexion admin, suivi de commande)
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @db.Timestamptz(3)
}
