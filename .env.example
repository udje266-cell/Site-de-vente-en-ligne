# --- Base de données (PostgreSQL) ---
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop"

# --- Auth admin (Auth.js / NextAuth) ---
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
# Utilisés UNIQUEMENT par le seed pour créer le compte admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# --- URL publique du site (sans / final) ---
APP_URL="http://localhost:3000"

# --- Paiement : "fake" (dev/tests) ou "cinetpay" (production) ---
PAYMENT_PROVIDER="fake"
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
# Clé secrète (Secret Key) du compte CinetPay : sert à vérifier le token HMAC des notifications
CINETPAY_SECRET_KEY=""

# --- E-mails : "console" (affiche dans les logs), "resend" ou "smtp" ---
MAIL_PROVIDER="console"
MAIL_FROM="Boutique <no-reply@example.com>"
RESEND_API_KEY=""
SMTP_URL=""

# --- SMS : "console" par défaut (fournisseur à choisir plus tard) ---
SMS_PROVIDER="console"

# --- Images : "local" (dossier public/uploads, dev uniquement) ou "cloudinary" ---
IMAGE_STORAGE="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Tâches planifiées (route /api/cron/expire-orders) ---
CRON_SECRET="change-me"
